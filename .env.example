# ============================================================
# SMTP / EMAIL SETUP
#
# Right now, no SMTP credentials are configured anywhere in this
# project, so Django falls back to EMAIL_BACKEND = console backend.
# That means contact-form emails are NOT actually sent anywhere —
# they're only printed to your terminal, and only saved in the
# database (Messages, visible in /admin).
#
# To make real emails send:
#   1. Copy this file to ".env" (same folder as manage.py):
#        cp .env.example .env
#   2. Fill in the values below with your real SMTP provider.
#   3. Install python-dotenv (already in requirements.txt):
#        pip install -r requirements.txt
#   4. Restart the server. Django will now load .env automatically.
#
# -------- Example: Gmail --------
# 1. Turn on 2-Step Verification on your Google account.
# 2. Create an "App Password": https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password below (NOT your normal Gmail password).
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=youraddress@gmail.com
# EMAIL_HOST_PASSWORD=your16charapppassword
# DEFAULT_FROM_EMAIL=youraddress@gmail.com
# DEFAULT_CONTACT_EMAIL=whereyouwanttoreceivemessages@gmail.com
#
# -------- Other providers --------
# Outlook/Office365: smtp.office365.com, port 587, TLS
# Yahoo:             smtp.mail.yahoo.com, port 587, TLS
# Custom domain:     ask your hosting provider for SMTP host/port
# ============================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
DEFAULT_CONTACT_EMAIL=


